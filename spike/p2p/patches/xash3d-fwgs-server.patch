diff --git a/engine/common/net_ws.c b/engine/common/net_ws.c
index 294ce59..df27ea4 100644
--- a/engine/common/net_ws.c
+++ b/engine/common/net_ws.c
@@ -25,6 +25,68 @@ GNU General Public License for more details.
 #include <SDL_thread.h>
 #endif
 
+#if XASH_EMSCRIPTEN
+#include <emscripten.h>
+// CS Party P5 (PHA-4004): a server in a browser tab. Emscripten's sockets can only dial out over a WebSocket
+// and can't accept peers, so when the page installs Module.cspNet, the server socket's datagrams go to JS
+// instead (WebRTC DataChannels in a tab, a dgram bridge under node). Addresses are opaque to the engine:
+// JS hands out one fake IPv4 address per peer and routes replies by it.
+#define CSP_HOOK_SOCKET 0x7ffffff0
+EM_JS( int, CSP_NetHooked, ( int unused ), { return Module.cspNet ? 1 : 0; } );
+EM_JS( void, CSP_NetListen, ( int port ), { Module.cspNet.listen( port ); } );
+EM_JS( int, CSP_NetSend, ( unsigned int ip, int port, const void *buf, int len ), {
+	Module.cspNet.send( ip >>> 0, port, HEAPU8.slice( buf, buf + len ));
+	return len;
+} );
+EM_JS( int, CSP_NetRecv, ( void *buf, int maxlen, unsigned int *ip, int *port ), {
+	const p = Module.cspNet.recv();
+	if( !p ) return -1;
+	const n = Math.min( p.data.length, maxlen );
+	HEAPU8.set( p.data.subarray( 0, n ), buf );
+	HEAPU32[ip >> 2] = p.ip >>> 0;
+	HEAP32[port >> 2] = p.port;
+	return n;
+} );
+
+static int CSP_SendTo( int s, const void *buf, size_t len, int flags, const struct sockaddr *to, socklen_t tolen )
+{
+	if( s != CSP_HOOK_SOCKET )
+		return sendto( s, buf, len, flags, to, tolen );
+	const struct sockaddr_in *sin = (const struct sockaddr_in *)to;
+	return CSP_NetSend( sin->sin_addr.s_addr, ntohs( sin->sin_port ), buf, len );
+}
+
+static int CSP_RecvFrom( int s, void *buf, size_t len, int flags, struct sockaddr *from, socklen_t *fromlen )
+{
+	if( s != CSP_HOOK_SOCKET )
+		return recvfrom( s, buf, len, flags, from, fromlen );
+	unsigned int ip; int port;
+	int n = CSP_NetRecv( buf, len, &ip, &port );
+	if( n < 0 )
+	{
+		errno = EWOULDBLOCK;
+		return -1;
+	}
+	struct sockaddr_in *sin = (struct sockaddr_in *)from;
+	memset( sin, 0, sizeof( *sin ));
+	sin->sin_family = AF_INET;
+	sin->sin_addr.s_addr = ip;
+	sin->sin_port = htons( port );
+	*fromlen = sizeof( *sin );
+	return n;
+}
+
+static int CSP_CloseSocket( int s )
+{
+	return s == CSP_HOOK_SOCKET ? 0 : close( s );
+}
+
+#define sendto CSP_SendTo
+#define recvfrom CSP_RecvFrom
+#undef closesocket
+#define closesocket CSP_CloseSocket
+#endif
+
 #define NET_USE_FRAGMENTS
 
 #define MAX_LOOPBACK		4
@@ -1732,6 +1794,14 @@ static void NET_OpenIP( qboolean change_port, int *sockets, const char *net_ifac
 			if( !port )
 				port = PORT_SERVER; // forcing to default
 		}
+#if XASH_EMSCRIPTEN
+		if( family == AF_INET && CSP_NetHooked( 0 ))
+		{
+			CSP_NetListen( port );
+			sockets[NS_SERVER] = CSP_HOOK_SOCKET;
+		}
+		else
+#endif
 		sockets[NS_SERVER] = NET_IPSocket( net_iface, port, family );
 
 		if( !NET_IsSocketValid( sockets[NS_SERVER] ) && Host_IsDedicated( ))
