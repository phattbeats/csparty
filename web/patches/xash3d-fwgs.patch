+			csp_last_state = (int)cls.state;
+			EM_ASM({ if (Module.onClientState) Module.onClientState($0); }, csp_last_state );
+		}
+	}
+#endif
 	if( cls.key_dest == key_game && cls.state == ca_active && !Con_Visible() )
 		Platform_SetTimer( cl_maxframetime.value );
 
