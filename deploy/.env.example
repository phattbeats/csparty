# Copy to deploy/.env and fill in. docker compose reads it automatically.
# Never commit the real .env.
PARTY_KEY=change-me-long-random-string
RCON_PASSWORD=change-me-too
# Optional
# PORT=8095
# MAXPLAYERS=16
# SV_LAN=0
# LOBBY_SECRET=

# ── PHATT ID (Authentik on vps1), PHA-4973 (2026-11-08) ─────────────────────────
# Provider "csparty" in https://auth.phatt.vip. Verify tokens against the JWKS (RS256, kid rotates by
# re-fetch), check iss + aud. The client secret is NOT here: it lives only in the host's real .env,
# handed over from vps1 /root/pha4973/secrets/csparty.oidc.env (root only).
OIDC_ISSUER=https://auth.phatt.vip/application/o/csparty/
OIDC_JWKS_URL=https://auth.phatt.vip/application/o/csparty/jwks/
OIDC_CLIENT_ID=csparty
# OIDC_CLIENT_SECRET=   (never commit)
OIDC_REDIRECT_URI=https://csparty.phatt.vip/auth/callback
OIDC_SCOPES="openid profile steam phatt_type"
